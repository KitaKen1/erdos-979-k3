    calc (ann.card : ℝ) ≤ ∑ y ∈ Finset.Icc (-(2 * (V : ℤ))) (2 * V), (Rb y : ℝ) := hc1
      _ = (∑ y ∈ A, (Rb y : ℝ)) + ∑ y ∈ B, (Rb y : ℝ) := hsplitR
      _ ≤ (4 * ((V : ℝ) - U) * 50 + 2 * (4 * sV + 3)) + 26 * (4 * sV + 3) := by

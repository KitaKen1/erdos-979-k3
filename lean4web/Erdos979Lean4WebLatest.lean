      rw [hUterm, Real.sqrt_div (by positivity),
        show (4 : ℝ) = 2 ^ 2 from by norm_num,
        Real.sqrt_sq (by norm_num : (0 : ℝ) ≤ 2), one_div_div]
    rw [hterm_eq]
    have hsqrtApos : (0 : ℝ) < Real.sqrt ((4 * U : ℝ) - 3 * (y : ℝ) ^ 2) :=

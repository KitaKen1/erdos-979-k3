    have hBsumR : (∑ y ∈ B, (Rb y : ℝ)) ≤ 26 * (4 * sV + 3) := by
      calc (∑ y ∈ B, (Rb y : ℝ)) = ((∑ y ∈ B, Rb y : ℕ) : ℝ) := by
            push_cast
            rfl

  have hthinR : (V : ℝ) - U ≤ 5 * (sV : ℝ) + 5 := by
    have h := (Nat.cast_le (α := ℝ)).mpr hthin
    push_cast at h
    rw [← hsV] at h
    linarith
  have hfinal : (ann.card : ℝ) ≤ 3000 * ((sV : ℝ) + 1) := by
    have h1 := hcast_main
    have h2 : (0 : ℝ) ≤ (sV : ℝ) := Nat.cast_nonneg sV
